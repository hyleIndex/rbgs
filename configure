#!/bin/sh

set -e

# Process arguments.  The CompCert integration has been removed from this
# branch; -nocompcert is still accepted (and ignored) for compatibility with
# upstream's instructions.

while [ $# -gt 0 ]; do
    case "$1" in
        -nocompcert)
            shift;;
        *)
            echo >&2 "Usage: $0 [-nocompcert]"
            exit 1;;
    esac
done

# Make sure the Coqrel submodule is available

if [ -e .git ] && ! [ -e coqrel/configure ]; then
    git submodule init coqrel
    git submodule update coqrel
fi

if ! [ -e coqrel/configure ]; then
    echo >&2 "Coqrel not found"
    exit 1
fi

# Prepare for build

echo >&2 "-- Configuring Coqrel"
(cd coqrel; ./configure)

echo >&2 "-- Pre-building Coqrel"
(cd coqrel; make)

echo >&2 "-- Creating Makefile"
coq_makefile -f _CoqProject -o Makefile
