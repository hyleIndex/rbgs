 MOV [x],$1     |               ;
 MOV [y],$1     |               ;
 MOV EDX,$2     |               ;
 XCHG [own],EDX |               ;
 MOV [z],$1     |               ;
exists (0:EAX=0 /\ 0:EBX=0 /\ 0:ECX=0 /\ 0:EDX=1 /\ 1:EAX=1 /\ 1:EBX=0 /\ 1:ECX=1 /\ 1:EDX=1 /\ 1:ESI=2)
