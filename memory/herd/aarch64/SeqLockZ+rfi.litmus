             | DMB LD          ;
             | LDR W11,[X4]    ;
             | LDR W12,[X5]    ;
             | DMB LD          ;
             | LDR W13,[X3]    ;
             | LDR W14,[X1]    ;
exists (0:X2=1 /\ 0:X6=0 /\ 0:X7=0 /\ 0:X8=0 /\ 0:X9=0 /\ 1:X10=2 /\ 1:X11=1 /\ 1:X12=1 /\ 1:X13=2 /\ 1:X14=0)
