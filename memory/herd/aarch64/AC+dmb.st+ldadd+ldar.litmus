AArch64 AC+dmb.st+ldadd+ldar
"Expected: Forbidden. Source: Coq memory/ARMBar.v, ARMBar.AtomicClause.ac_ldar_nodmbld_forbidden. LDAR get, no DMB LD. UNVERIFIED -- run herd7"
{
0:X1=x; 0:X2=s;
1:X1=x; 1:X2=s;
}
 P0               | P1           ;
 MOV W0,#1        | LDAR W0,[X2] ;
 STR W0,[X1]      | LDR W3,[X1]  ;
 DMB ST           |              ;
 MOV W5,#1        |              ;
 LDADD W5,W6,[X2] |              ;
exists (1:X0=1 /\ 1:X3=0)
