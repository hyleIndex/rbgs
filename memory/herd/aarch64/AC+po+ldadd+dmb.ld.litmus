AArch64 AC+po+ldadd+dmb.ld
"Expected: Allowed. Source: Coq memory/ARMBar.v, ARMBar.AtomicClause.ac_nodmbst_allowed. No DMB ST, relaxed RMW (dto(DW,DRMW)=false). UNVERIFIED -- run herd7"
{
0:X1=x; 0:X2=s;
1:X1=x; 1:X2=s;
}
 P0               | P1          ;
 MOV W0,#1        | LDR W0,[X2] ;
 STR W0,[X1]      | DMB LD      ;
 MOV W5,#1        | LDR W3,[X1] ;
 LDADD W5,W6,[X2] |             ;
exists (1:X0=1 /\ 1:X3=0)
