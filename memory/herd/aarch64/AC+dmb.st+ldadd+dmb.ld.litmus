AArch64 AC+dmb.st+ldadd+dmb.ld
"Expected: Forbidden. Source: Coq memory/ARMBar.v, ARMBar.AtomicClause.ac_ldadd_ldr_forbidden (every RMW flavour, plain LDR get). UNVERIFIED -- run herd7"
{
0:X1=x; 0:X2=s;
1:X1=x; 1:X2=s;
}
 P0               | P1          ;
 MOV W0,#1        | LDR W0,[X2] ;
 STR W0,[X1]      | DMB LD      ;
 DMB ST           | LDR W3,[X1] ;
 MOV W5,#1        |             ;
 LDADD W5,W6,[X2] |             ;
exists (1:X0=1 /\ 1:X3=0)
