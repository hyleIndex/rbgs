AArch64 VW+ldaddl+dmb.sy
"Expected: Forbidden. Source: Coq memory/ARMBar.v, ARMBar.VW.vw_dmbsy_forbidden (every flavour). UNVERIFIED -- run herd7"
{
0:X1=s; 0:X2=z;
1:X1=s; 1:X2=z;
}
 P0                | P1          ;
 MOV W5,#1         | LDR W0,[X2] ;
 LDADDL W5,W6,[X1] | DMB LD      ;
 DMB SY            | LDR W3,[X1] ;
 MOV W0,#1         |             ;
 STR W0,[X2]       |             ;
exists (1:X0=1 /\ 1:X3=0)
